<?xml version="1.0" encoding="utf-8"?><!--
   Explicitly excludes the member database and shared prefs from cloud backup and device-to-device
   transfer (API 31+). android:allowBackup is "false" in the manifest, so this file is not
   currently active, but it is kept correct as defence in depth: if allowBackup is ever flipped
   back on, the member roster and message log must still not leave the device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
