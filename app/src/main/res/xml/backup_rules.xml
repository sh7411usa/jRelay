<?xml version="1.0" encoding="utf-8"?><!--
   Explicitly excludes the member database and shared prefs from Auto Backup (API < 31).
   android:allowBackup is "false" in the manifest, so this file is not currently active, but it
   is kept correct as defence in depth: if allowBackup is ever flipped back on, the member roster
   and message log must still not leave the device.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
