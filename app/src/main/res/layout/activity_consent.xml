<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout style="@style/Widget.JRelay.Header">
            <TextView style="@style/TextAppearance.JRelay.HeaderTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_title" />
        </LinearLayout>
        <LinearLayout style="@style/Widget.JRelay.Page">
            <TextView style="@style/TextAppearance.JRelay.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_body" />
            <TextView style="@style/Widget.JRelay.SectionTitle"
                android:text="@string/consent_permissions_title" />
            <TextView style="@style/TextAppearance.JRelay.RowTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_perm_send_title" />
            <TextView style="@style/TextAppearance.JRelay.RowCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:text="@string/consent_perm_send_desc" />
            <TextView style="@style/TextAppearance.JRelay.RowTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_perm_receive_title" />
            <TextView style="@style/TextAppearance.JRelay.RowCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:text="@string/consent_perm_receive_desc" />
            <TextView style="@style/TextAppearance.JRelay.RowTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_perm_mms_title" />
            <TextView style="@style/TextAppearance.JRelay.RowCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:text="@string/consent_perm_mms_desc" />
            <TextView style="@style/TextAppearance.JRelay.RowTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_perm_notify_title" />
            <TextView style="@style/TextAppearance.JRelay.RowCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:text="@string/consent_perm_notify_desc" />
            <TextView style="@style/Widget.JRelay.Banner.Info"
                android:text="@string/consent_permissions_note" />
            <TextView style="@style/Widget.JRelay.SectionTitle"
                android:text="@string/consent_license_title" />
            <TextView android:id="@+id/text_view_license_link"
                style="@style/Widget.JRelay.Button.Outline"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:gravity="center"
                android:clickable="true" android:focusable="true"
                android:text="@string/consent_read_license" />
            <CheckBox android:id="@+id/checkbox_license_agree" style="@style/Widget.JRelay.CheckBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/consent_license_agree" />
            <LinearLayout style="@style/Widget.JRelay.ButtonBar">
                <Button android:id="@+id/button_agree" style="@style/Widget.JRelay.Button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" android:text="@string/consent_agree" />
                <Button android:id="@+id/button_decline" style="@style/Widget.JRelay.Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/consent_decline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
