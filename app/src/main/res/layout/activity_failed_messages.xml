<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/failed_messages_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/failed_messages_help"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/button_retry_all_safe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/retry_all_safe"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/text_no_failed_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_failed_messages"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_failed_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
