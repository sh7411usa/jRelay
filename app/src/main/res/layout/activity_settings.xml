                    android:text="@string/rate_limit_system_desc" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/text_system_permission_notice" style="@style/TextAppearance.JRelay.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/warning" android:visibility="gone"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/focus_highlight" android:padding="8dp"
                    android:layout_marginBottom="8dp" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_system_max_count" />
                <EditText android:id="@+id/edit_system_max_count"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/hint_system_max_count" android:inputType="number"
                    android:layout_marginBottom="8dp" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_system_interval_minutes" />
                <EditText android:id="@+id/edit_system_interval"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/hint_system_interval_minutes" android:inputType="number"
                    android:layout_marginBottom="16dp" />
                <Button android:id="@+id/button_system_save" style="@style/Widget.JRelay.Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/action_save" android:layout_marginBottom="28dp" />
