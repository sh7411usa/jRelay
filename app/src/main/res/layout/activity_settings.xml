                android:orientation="vertical" android:visibility="gone">

                <TextView style="@style/Widget.JRelay.SectionTitle" android:text="@string/section_message_content" />
                <CheckBox android:id="@+id/checkbox_append_sender_number" style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/checkbox_append_sender_number" android:layout_marginBottom="2dp" />
                <TextView style="@style/TextAppearance.JRelay.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/append_sender_number_desc" android:layout_marginBottom="12dp" />
                <CheckBox android:id="@+id/checkbox_strip_phone_numbers" style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/checkbox_strip_phone_numbers" android:layout_marginBottom="2dp" />
                <TextView style="@style/TextAppearance.JRelay.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/strip_phone_numbers_desc" android:layout_marginBottom="28dp" />

                <TextView style="@style/Widget.JRelay.SectionTitle"
                    android:text="@string/section_salting" android:layout_marginBottom="4dp" />
                <TextView style="@style/TextAppearance.JRelay.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/salting_desc" android:layout_marginBottom="8dp" />
                <CheckBox android:id="@+id/checkbox_salt_timestamp" style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/checkbox_salt_timestamp" android:layout_marginBottom="4dp" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_salt_timestamp_format" />
                <Spinner android:id="@+id/spinner_salt_timestamp_format" style="@style/Widget.JRelay.Spinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:entries="@array/salt_timestamp_format_options" android:layout_marginBottom="12dp" />
                <CheckBox android:id="@+id/checkbox_salt_hex" style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/checkbox_salt_hex" android:layout_marginBottom="4dp" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_salt_hex_position" />
                <Spinner android:id="@+id/spinner_salt_hex_position" style="@style/Widget.JRelay.Spinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:entries="@array/salt_hex_position_options" android:layout_marginBottom="12dp" />
                <CheckBox android:id="@+id/checkbox_salt_zwsp" style="@style/Widget.JRelay.CheckBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/checkbox_salt_zwsp" android:layout_marginBottom="12dp" />
                <Button android:id="@+id/button_save_content" style="@style/Widget.JRelay.Button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/action_save" android:layout_marginBottom="28dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/settings_cat_app"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView style="@style/Widget.JRelay.SectionTitle" android:text="@string/section_language" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_language" />
                <Spinner android:id="@+id/spinner_language" style="@style/Widget.JRelay.Spinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:entries="@array/language_options" android:layout_marginBottom="28dp" />

                <TextView style="@style/Widget.JRelay.SectionTitle" android:text="@string/section_appearance" />
                <TextView style="@style/TextAppearance.JRelay.Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_theme" />
                <Spinner android:id="@+id/spinner_theme" style="@style/Widget.JRelay.Spinner"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:entries="@array/theme_options" android:layout_marginBottom="28dp" />

                <TextView style="@style/Widget.JRelay.SectionTitle" android:text="@string/section_miscellaneous" />
                <Button android:id="@+id/button_clear_history" style="@style/Widget.JRelay.Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />
                <Button android:id="@+id/button_disband_group" style="@style/Widget.JRelay.Button.Danger"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/action_disband_group" android:layout_marginBottom="12dp" />
                <Button android:id="@+id/button_view_license" style="@style/Widget.JRelay.Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/action_view_license" />

                <TextView style="@style/Widget.JRelay.SectionTitle"
                    android:text="@string/section_about" android:layout_marginTop="28dp" />
                <TextView android:id="@+id/text_app_version" style="@style/TextAppearance.JRelay.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
